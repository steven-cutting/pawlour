{
  "config": {
    "default": true,
    // Prose is wrapped by the author, not by a column limit.
    "MD013": false,
    // Duplicate headings are legitimate under different parents.
    "MD024": { "siblings_only": true },
    // Frontmatter carries a title field, but the level-one heading in the body
    // is the document's real title and the contract requires it.
    "MD025": { "front_matter_title": "" },
    "MD033": { "allowed_elements": ["br"] },
    // The documentation contract owns the first heading, not markdownlint.
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    ".svelte-kit",
    "build",
    "coverage",
    "storybook-static",
    "ai_tmp",
    ".venv",
    "blender/src",
    "tickets",
    // Vendored Allium skills from juxt/allium, pinned by skills-lock.json and
    // kept byte for byte so an update is a clean replace.
    ".agents/skills/allium",
    ".claude/skills/allium",
    ".agents/skills/distill",
    ".claude/skills/distill",
    ".agents/skills/elicit",
    ".claude/skills/elicit",
    ".agents/skills/propagate",
    ".claude/skills/propagate",
    ".agents/skills/tend",
    ".claude/skills/tend",
    ".agents/skills/weed",
    ".claude/skills/weed",
    ".agents/skills/witness",
    ".claude/skills/witness"
  ]
}
